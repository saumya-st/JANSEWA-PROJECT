# Copy this file to .env and fill in the values.
#
# WARNING: every VITE_* variable is embedded in the browser bundle and is
# visible to anyone who opens the site. Firebase and Supabase anon keys are
# designed for this and are protected by Firestore rules / Storage policies.
# The Gemini key is NOT: restrict it by HTTP referrer (your dev and production
# origins) in Google AI Studio -> API keys, and set usage quotas on it.

# Firebase: Console -> Project settings -> General -> Your apps -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional. Only needed if Google Analytics is enabled on the Firebase project.
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase: Dashboard -> Project Settings -> API (Project URL and anon public key).
# Used only for the `issue-images` Storage bucket.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AI Studio -> Get API key (https://aistudio.google.com/app/apikey).
# Called client-side for priority prediction; see the warning above.
VITE_GEMINI_API_KEY=
